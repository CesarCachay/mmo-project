generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountProvider {
  GOOGLE
  LOCAL
}

model Account {
  id String @id @default(uuid()) @db.Uuid

  provider       AccountProvider
  providerUserId String          @map("provider_user_id") @db.VarChar(255)

  email String? @db.VarChar(320)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trainers           PokemonTrainer[]
  sessions           AccountSession[]
  passwordCredential AccountPasswordCredential?

  @@unique([provider, providerUserId])
  @@index([email])
  @@map("accounts")
}

model AccountSession {
  id String @id @default(uuid()) @db.Uuid

  accountId String @map("account_id") @db.Uuid

  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("account_sessions")
}

model AccountPasswordCredential {
  accountId String @id @map("account_id") @db.Uuid

  passwordHash String @map("password_hash") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("account_password_credentials")
}

model PokemonTrainer {
  id String @id @db.Uuid

  accountId String @map("account_id") @db.Uuid

  displayName String @map("display_name") @db.VarChar(16)
  avatarId    String @map("avatar_id") @db.VarChar(64)

  worldMapId     String? @map("world_map_id") @db.VarChar(64)
  worldX         Float?  @map("world_x")
  worldY         Float?  @map("world_y")
  worldDirection String? @map("world_direction") @db.VarChar(8)

  recoveryMapId     String? @map("recovery_map_id") @db.VarChar(64)
  recoveryX         Float?  @map("recovery_x")
  recoveryY         Float?  @map("recovery_y")
  recoveryDirection String? @map("recovery_direction") @db.VarChar(8)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  pokemonInstances    PokemonInstance[]
  inventoryItems      PokemonTrainerInventoryItem[]
  pendingMoveLearning PokemonPendingMoveLearning[]
  pendingEvolutions   PokemonPendingEvolution[]
  trainerBattleProgress PokemonTrainerBattleProgress[]

  @@index([accountId])
  @@map("pokemon_trainers")
}

model PokemonInstance {
  id String @id @map("instance_id") @db.Uuid

  trainerId String @map("trainer_id") @db.Uuid

  speciesId Int     @map("species_id")
  formId    Int     @map("form_id")
  nickname  String?

  level      Int
  experience Int
  currentHp  Int @map("current_hp")
  abilityId  Int @map("ability_id")

  partyPosition Int? @map("party_position")

  trainer PokemonTrainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  moves PokemonInstanceMove[]

  pendingMoveLearning PokemonPendingMoveLearning?

  pendingEvolution PokemonPendingEvolution?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([trainerId, partyPosition])
  @@index([trainerId])
  @@map("pokemon_instances")
}

model PokemonInstanceMove {
  pokemonInstanceId String @map("pokemon_instance_id") @db.Uuid

  slot      Int
  moveId    Int @map("move_id")
  currentPp Int @map("current_pp")

  pokemon PokemonInstance @relation(fields: [pokemonInstanceId], references: [id], onDelete: Cascade)

  @@id([pokemonInstanceId, slot])
  @@map("pokemon_instance_moves")
}

model PokemonPendingMoveLearning {
  id String @id @default(uuid()) @db.Uuid

  trainerId         String @map("trainer_id") @db.Uuid
  pokemonInstanceId String @unique @map("pokemon_instance_id") @db.Uuid

  candidateMoveId         Int @map("candidate_move_id")
  candidateLearnedAtLevel Int @map("candidate_learned_at_level")

  remainingCandidates Json @map("remaining_candidates") @db.JsonB

  revision Int @default(0)

  trainer PokemonTrainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  pokemon PokemonInstance @relation(fields: [pokemonInstanceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([trainerId])
  @@map("pokemon_pending_move_learning")
}

model PokemonTrainerInventoryItem {
  trainerId String @map("trainer_id") @db.Uuid
  itemId    String @map("item_id") @db.VarChar(64)
  quantity  Int

  trainer PokemonTrainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@id([trainerId, itemId])
  @@map("pokemon_trainer_inventory_items")
}

model PokemonPendingEvolution {
  id String @id @default(uuid()) @db.Uuid

  trainerId         String @map("trainer_id") @db.Uuid
  pokemonInstanceId String @unique @map("pokemon_instance_id") @db.Uuid

  sourceSpeciesId Int @map("source_species_id")
  sourceFormId    Int @map("source_form_id")

  targetSpeciesId Int @map("target_species_id")
  targetFormId    Int @map("target_form_id")

  triggerLevel Int @map("trigger_level")

  revision Int @default(0)

  trainer PokemonTrainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  pokemon PokemonInstance @relation(fields: [pokemonInstanceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([trainerId])
  @@map("pokemon_pending_evolutions")
}

model PokemonTrainerBattleProgress {
  trainerId       String   @map("trainer_id") @db.Uuid
  trainerBattleId String   @map("trainer_battle_id") @db.VarChar(64)
  defeatedAt      DateTime @default(now()) @map("defeated_at")

  trainer PokemonTrainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@id([trainerId, trainerBattleId])
  @@index([trainerBattleId])
  @@map("pokemon_trainer_battle_progress")
}
