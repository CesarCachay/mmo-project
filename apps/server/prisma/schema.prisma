generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PokemonTrainer {
  id               String @id @db.Uuid
  sessionTokenHash String @unique @map("session_token_hash")

  worldMapId     String? @map("world_map_id") @db.VarChar(64)
  worldX         Float?  @map("world_x")
  worldY         Float?  @map("world_y")
  worldDirection String? @map("world_direction") @db.VarChar(8)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pokemonInstances PokemonInstance[]
  inventoryItems   PokemonTrainerInventoryItem[]

  pendingMoveLearning PokemonPendingMoveLearning[]

  @@map("pokemon_trainers")
}

model PokemonInstance {
  id String @id @map("instance_id") @db.Uuid

  trainerId String @map("trainer_id") @db.Uuid

  speciesId Int     @map("species_id")
  formId    Int     @map("form_id")
  nickname  String?

  level      Int
  experience Int
  currentHp  Int @map("current_hp")
  abilityId  Int @map("ability_id")

  partyPosition Int? @map("party_position")

  trainer PokemonTrainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  moves PokemonInstanceMove[]

  pendingMoveLearning PokemonPendingMoveLearning?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([trainerId, partyPosition])
  @@index([trainerId])
  @@map("pokemon_instances")
}

model PokemonInstanceMove {
  pokemonInstanceId String @map("pokemon_instance_id") @db.Uuid

  slot      Int
  moveId    Int @map("move_id")
  currentPp Int @map("current_pp")

  pokemon PokemonInstance @relation(fields: [pokemonInstanceId], references: [id], onDelete: Cascade)

  @@id([pokemonInstanceId, slot])
  @@map("pokemon_instance_moves")
}

model PokemonPendingMoveLearning {
  id String @id @default(uuid()) @db.Uuid

  trainerId         String @map("trainer_id") @db.Uuid
  pokemonInstanceId String @unique @map("pokemon_instance_id") @db.Uuid

  candidateMoveId         Int @map("candidate_move_id")
  candidateLearnedAtLevel Int @map("candidate_learned_at_level")

  remainingCandidates Json @map("remaining_candidates") @db.JsonB

  revision Int @default(0)

  trainer PokemonTrainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  pokemon PokemonInstance @relation(fields: [pokemonInstanceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([trainerId])
  @@map("pokemon_pending_move_learning")
}

model PokemonTrainerInventoryItem {
  trainerId String @map("trainer_id") @db.Uuid
  itemId    String @map("item_id") @db.VarChar(64)
  quantity  Int

  trainer PokemonTrainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@id([trainerId, itemId])
  @@map("pokemon_trainer_inventory_items")
}
