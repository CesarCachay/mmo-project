{
  "name": "pokemmo-cesar-edition",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:maps": "node scripts/generate-map-data.mjs",
    "build": "pnpm run build:shared && pnpm --filter server build && pnpm --filter client build",
    "build:shared": "pnpm --filter @cesar-mmo/shared build",
    "build:server": "pnpm --filter server build",
    "build:client": "pnpm --filter client build",
    "dev": "pnpm --filter @cesar-mmo/shared build && pnpm -r --parallel --filter client --filter server --filter @cesar-mmo/shared run dev",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "dev:shared": "pnpm --filter @cesar-mmo/shared dev",
    "pokemon:import": "node scripts/import-pokemon-data.mjs",
    "pokemon:validate": "node scripts/validate-pokemon-data.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
