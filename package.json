{
  "name": "pokemmo-cesar-edition",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.21.0",
    "pnpm": "11.21.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "generate:maps": "node scripts/generate-map-data-full-route-chain.mjs",
    "prisma:generate": "pnpm --filter server prisma:generate",
    "prisma:validate": "pnpm --filter server prisma:validate",
    "prisma:migrate:status": "pnpm --filter server prisma:migrate:status",
    "prisma:migrate:deploy": "pnpm --filter server prisma:migrate:deploy",
    "build": "pnpm run build:shared && pnpm --filter server build && pnpm --filter client build",
    "build:shared": "pnpm --filter @cesar-mmo/shared build",
    "build:server": "pnpm --filter server build",
    "build:client": "pnpm --filter client build",
    "dev": "pnpm --filter @cesar-mmo/shared build && pnpm -r --parallel --filter client --filter server --filter @cesar-mmo/shared run dev",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "dev:shared": "pnpm --filter @cesar-mmo/shared dev",
    "pokemon:import": "node scripts/import-pokemon-data.mjs",
    "pokemon:validate": "node scripts/validate-pokemon-data.mjs",
    "test": "pnpm run build:shared && vitest run",
    "test:watch": "pnpm run build:shared && vitest",
    "gym:audit": "node scripts/audit-gym-leader-v1.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "vitest": "^5.0.0"
  }
}
